# Public site settings (use the production HTTPS domain and a monitored mailbox)
NEXT_PUBLIC_SITE_URL=https://dawremdownloader.com
NEXT_PUBLIC_CONTACT_EMAIL=contact@your-domain.example

# Adsterra Native Banner: use values from your approved account snippet.
# Leave blank until your domain is approved and the code is provided.
NEXT_PUBLIC_ADSTERRA_SCRIPT_URL=
NEXT_PUBLIC_ADSTERRA_CONTAINER_ID=

# Optional writable directory for downloaded media and job records
# TEMP_DIR=
